# Docker Compose reads this file after copying it to .env.
NOTES_PORT=3000
REGISTRATION_OPEN=true
# Set the exact external origin when using a reverse proxy.
# PUBLIC_URL=https://heinote.example.com
# Optional GitHub login. Set all three values together on the server.
# For local development, use PUBLIC_URL=http://localhost:3000.
# Register the callback at PUBLIC_URL/api/auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
