#!/usr/bin/env python3
"""heinote — 小黑笔记 HTTP API 命令行封装。

配置（二选一，环境变量优先）:
  export HEINOTE_URL=http://localhost:3000
  export HEINOTE_TOKEN=notes_...
或写入 ~/.config/heinote/env（建议 chmod 600）:
  HEINOTE_URL=http://localhost:3000
  HEINOTE_TOKEN=notes_...

用法概览见 `heinote --help`。写命令自动完成：
  - Bearer 认证头
  - 写前 GET 目标，注入当前 generation / baseRevision / databaseRevision
  - 确定性 requestId：业务参数（不含服务端修订）的 SHA-256 前 32 位。
    同一命令重试命中服务端幂等缓存，不重复写入；--request-id 可显式覆盖。
"""
import argparse
import hashlib
import json
import os
import sys
import urllib.error
import urllib.request

# A Windows console and a pipe both default to GBK. Text that file cannot
# encode — the ✓ in a page title, an emoji — makes print() raise
# UnicodeEncodeError and aborts the command with a traceback; and the GBK bytes
# a pipe receives are not what a caller expecting UTF-8 JSON decodes. So: when
# the stream is not a terminal, write UTF-8; on a terminal keep its own encoding
# and escape what it cannot encode as \uXXXX, which is readable in the status
# lines and still a valid JSON escape inside the payload.
for _stream in (sys.stdout, sys.stderr):
    try:
        if not _stream.isatty():
            _stream.reconfigure(encoding="utf-8")
        _stream.reconfigure(errors="backslashreplace")
    except (AttributeError, ValueError, OSError):
        pass

ENV_FILE = os.path.expanduser("~/.config/heinote/env")
DEFAULT_URL = "http://localhost:3000"


def die(message, code=2):
    print(f"heinote: {message}", file=sys.stderr)
    sys.exit(code)


def load_config():
    cfg = {}
    if os.path.exists(ENV_FILE):
        try:
            for line in open(ENV_FILE, encoding="utf-8"):
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                cfg[key.strip()] = value.strip().strip('"').strip("'")
        except OSError as e:
            die(f"无法读取 {ENV_FILE}: {e}")
    for key in ("HEINOTE_URL", "HEINOTE_TOKEN"):
        if os.environ.get(key):
            cfg[key] = os.environ[key]
    return cfg


def read_value(value):
    """`-` 从标准输入读取，否则按原样返回。"""
    return sys.stdin.read() if value == "-" else value


def read_json(value):
    text = read_value(value)
    if os.path.exists(text):
        try:
            text = open(text, encoding="utf-8").read()
        except OSError as e:
            die(f"无法读取 {text}: {e}")
    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        die(f"JSON 解析失败: {e}")


class Client:
    def __init__(self, require_token=True):
        cfg = load_config()
        self.url = (cfg.get("HEINOTE_URL") or DEFAULT_URL).rstrip("/")
        self.token = cfg.get("HEINOTE_TOKEN")
        if require_token and not self.token:
            die("缺少 HEINOTE_TOKEN。先用 `heinote auth-request` 申请一条，"
                "或在账号 → Agent 令牌创建后 export HEINOTE_TOKEN=notes_... "
                "或写入 " + ENV_FILE)

    def request(self, method, path, body=None):
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(
            self.url + path, data=data, method=method,
            headers={"Authorization": f"Bearer {self.token}",
                     "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=60) as res:
                status, text = res.status, res.read().decode()
        except urllib.error.HTTPError as e:
            status, text = e.code, e.read().decode()
        except urllib.error.URLError as e:
            die(f"无法连接 {self.url}: {e.reason}")
        try:
            payload = json.loads(text) if text else None
        except json.JSONDecodeError:
            payload = text
        print(f"# {method} {path} -> {status}", file=sys.stderr)
        return status, payload


def emit(status, payload):
    print(json.dumps(payload, ensure_ascii=False, indent=2)
          if payload is not None else "null")
    if status >= 400:
        sys.exit(1)


def is_duplicate_conflict(payload) -> bool:
    """服务端缓存了同 requestId 但摘要不同的请求：本次命令在另一修订下
    已被应用过（通常是重跑已成功命令）。返回 True 表示「已应用，无需重发」。"""
    return (isinstance(payload, dict)
            and payload.get("code") == "conflict"
            and "已用于其他操作" in str(payload.get("error", "")))


def request_id(*parts):
    seed = json.dumps(parts, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return "heinote-" + hashlib.sha256(seed.encode()).hexdigest()[:32]


def page_state(client, page_id):
    status, payload = client.request("GET", f"/api/v1/pages/{page_id}")
    if status != 200 or not isinstance(payload, dict):
        emit(status, payload)
    return payload


def mutate(client, method, path, body, seed, request_id_arg, force=False):
    """写请求：确定性 requestId（只含业务参数，不含服务端修订）+ 输出。

    同一命令重跑得到相同 requestId。若上次已成功、修订已前进，
    服务端因摘要不同返回 409「请求 ID 已用于其他操作」。此时输出
    「已应用」提示而非原始报错，避免把重跑误当失败，也避免双写。
    `--force`（或 --request-id）生成新标识，允许有意重复相同输入。"""
    if "requestId" not in body:
        body["requestId"] = request_id_arg or request_id(method, path, seed)
    if force:
        body["requestId"] = request_id(method, path, seed, "force")
    status, payload = client.request(method, path, body)
    if status == 409 and is_duplicate_conflict(payload):
        print(f"# {method} {path} -> 409（相同命令已应用，未重复写入）", file=sys.stderr)
        print(json.dumps({"deduplicated": True, "requestId": body["requestId"],
                          "hint": "上次同命令已成功；如需再次应用请加 --force 或 --request-id"},
                         ensure_ascii=False))
        sys.exit(0)
    emit(status, payload)


def ops_body(client, page_id, operations, mode, request_id_arg, force=False):
    page = page_state(client, page_id)
    collab = page.get("collaboration") or {}
    body = {"generation": collab.get("generation"),
            "baseRevision": page.get("revision"),
            "mode": mode, "operations": operations}
    if not body["generation"]:
        die("页面响应缺少 collaboration.generation，无法提交结构化修改。")
    mutate(client, "POST", f"/api/v1/pages/{page_id}/operations", body,
           ("ops", page_id, mode, operations), request_id_arg, force)


def cmd_search(client, a):
    from urllib.parse import urlencode
    params = {"q": a.query}
    if a.space:
        params["space"] = a.space
    if a.include_archived:
        params["include_archived"] = "true"
    if a.limit is not None:
        params["limit"] = a.limit
    if a.offset:
        params["offset"] = a.offset
    status, payload = client.request("GET", f"/api/v1/search?{urlencode(params)}")
    emit(status, payload)


def cmd_pages(client, a):
    status, payload = client.request("GET", "/api/v1/pages")
    if a.full or not isinstance(payload, list):
        emit(status, payload)
    summary = [{"id": p.get("id"), "title": p.get("title"),
                "kind": (p.get("page") or {}).get("kind"),
                "parent_id": (p.get("page") or {}).get("parent_id"),
                "scope": p.get("scope")} for p in payload]
    emit(status, summary)


def cmd_page(client, a):
    status, payload = client.request("GET", f"/api/v1/pages/{a.id}")
    emit(status, payload)


def cmd_markdown(client, a):
    status, payload = client.request("GET", f"/api/v1/pages/{a.id}/markdown")
    if status != 200 or not isinstance(payload, dict):
        emit(status, payload)
    text = payload.get("markdown") or ""
    if a.out:
        target = os.path.expanduser(a.out)
        with open(target, "w", encoding="utf-8") as f:
            f.write(text)
        emit(200, {"saved": target, "title": payload.get("title"),
                   "revision": payload.get("revision")})
    else:
        sys.stdout.write(text)
        if text and not text.endswith("\n"):
            sys.stdout.write("\n")


def cmd_create_page(client, a):
    if a.text is not None and a.markdown is not None:
        die("--text 与 --markdown 只能提供一个。")
    body = {"title": a.title or ""}
    if a.markdown is not None:
        body["markdown"] = read_value(a.markdown)
    else:
        body["text"] = read_value(a.text) if a.text else ""
    for flag, key in (("parent_id", "parentId"), ("space_id", "spaceId"), ("scope", "scope")):
        if getattr(a, flag):
            body[key] = getattr(a, flag)
    if a.kind:
        body["kind"] = a.kind
        body.pop("text", None)
        body.pop("markdown", None)
    status, payload = client.request("POST", "/api/v1/pages", body)
    emit(status, payload)


def cmd_copy(client, a):
    body = {}
    if a.space_id:
        body["spaceId"] = a.space_id
    if a.parent_id:
        body["parentId"] = a.parent_id
    mutate(client, "POST", f"/api/v1/pages/{a.id}/copy", body, body, a.request_id, a.force)


def cmd_set_title(client, a):
    page = page_state(client, a.id)
    body = {"baseRevision": page["revision"], "title": a.title}
    status, payload = client.request("PATCH", f"/api/v1/pages/{a.id}", body)
    emit(status, payload)


def cmd_append(client, a):
    if a.text is not None and a.markdown is not None:
        die("--text 与 --markdown 只能提供一个。")
    if a.markdown is not None:
        if a.kind:
            die("--kind 只作用于 --text 的单块插入。")
        op = {"type": "insert_blocks", "markdown": read_value(a.markdown)}
    else:
        if a.text is None:
            die("append 需要 --text 或 --markdown。")
        op = {"type": "insert_block", "text": read_value(a.text)}
        if a.format:
            op["format"] = a.format
    if a.kind and op["type"] == "insert_block":
        op["kind"] = a.kind
    ops_body(client, a.id, [op], "suggest" if a.suggest else "apply", a.request_id, a.force)


def cmd_ops(client, a):
    operations = read_json(a.ops)
    if not isinstance(operations, list):
        die("--ops 需要 JSON 操作数组。")
    ops_body(client, a.id, operations, "suggest" if a.suggest else "apply", a.request_id, a.force)


def cmd_proposals(client, a):
    status, payload = client.request("GET", f"/api/v1/pages/{a.id}/proposals")
    emit(status, payload)


def cmd_versions(client, a):
    status, payload = client.request("GET", f"/api/v1/pages/{a.id}/versions")
    emit(status, payload)


def cmd_checkpoint(client, a):
    body = {"summary": a.summary} if a.summary else {}
    status, payload = client.request("POST", f"/api/v1/pages/{a.id}/checkpoint", body)
    emit(status, payload)


def cmd_restore(client, a):
    body = {"versionId": a.version_id}
    if not a.no_revision:
        body["baseRevision"] = page_state(client, a.id)["revision"]
    status, payload = client.request("POST", f"/api/v1/pages/{a.id}/restore", body)
    emit(status, payload)


def cmd_enable(client, a):
    page = page_state(client, a.id)
    body = {"baseRevision": page["revision"]}
    mutate(client, "POST", f"/api/v1/pages/{a.id}/enable", body,
           ("enable", a.id), a.request_id, a.force)


def cmd_get_app(client, a):
    page = page_state(client, a.id)
    if page.get("page", {}).get("kind") != "app":
        die("目标页面不是应用页面。")
    app = page.get("page", {}).get("app") or {}
    source = app.get("draft") if app.get("draft") is not None else app.get("enabled")
    if source is None:
        die("应用页面还没有源码（draft 与 enabled 都为空）。")
    if a.out:
        with open(os.path.expanduser(a.out), "w", encoding="utf-8") as f:
            f.write(source)
        emit(200, {"saved": a.out, "bytes": len(source.encode("utf-8")),
                   "from": "draft" if app.get("draft") is not None else "enabled"})
    else:
        sys.stdout.write(source)


def cmd_set_app(client, a):
    page = page_state(client, a.id)
    if page.get("page", {}).get("kind") != "app":
        die("目标页面不是应用页面（create-page --kind app 创建）。")
    if a.file == "-":
        source = sys.stdin.read()
    elif os.path.isfile(os.path.expanduser(a.file)):
        with open(os.path.expanduser(a.file), encoding="utf-8") as f:
            source = f.read()
    else:
        die(f"文件不存在: {a.file}")
    body = {"baseRevision": page["revision"], "app": {"draft": source}}
    status, payload = client.request("PATCH", f"/api/v1/pages/{a.id}", body)
    emit(status, payload)
    if a.draft_only:
        return
    # PATCH 不接受 requestId；enable 的幂等仍走 mutate 的确定性标识。
    current = page_state(client, a.id)
    mutate(client, "POST", f"/api/v1/pages/{a.id}/enable",
           {"baseRevision": current["revision"]}, ("enable", a.id, hashlib.sha256(source.encode()).hexdigest()[:16]),
           a.request_id, a.force)


def db_state(client, db_id):
    status, payload = client.request("GET", f"/api/v1/databases/{db_id}")
    if status != 200 or not isinstance(payload, dict):
        emit(status, payload)
    return payload


def cmd_db(client, a):
    status, payload = client.request("GET", f"/api/v1/databases/{a.id}")
    emit(status, payload)


def cmd_db_query(client, a):
    body = read_json(a.query) if a.query else {}
    status, payload = client.request("POST", f"/api/v1/databases/{a.id}/query", body)
    emit(status, payload)


def cmd_db_create(client, a):
    data = read_json(a.data)
    body = data if isinstance(data, dict) else {}
    mutate(client, "POST", "/api/v1/databases", body,
           ("db-create", body), a.request_id, a.force)


def cmd_row_create(client, a):
    db = db_state(client, a.db)
    data = read_json(a.data)
    if not isinstance(data, dict):
        die("--data 需要 JSON 对象（title / text / properties）。")
    body = {"baseRevision": db["revision"], **data}
    mutate(client, "POST", f"/api/v1/databases/{a.db}/rows", body,
           ("row-create", a.db, data), a.request_id, a.force)


def cmd_row_set(client, a):
    db = db_state(client, a.db)
    row = page_state(client, a.row)
    data = read_json(a.data)
    if not isinstance(data, dict):
        die("--data 需要 JSON 对象（title / properties / propertyFiles）。")
    body = {"baseRevision": row["revision"],
            "databaseRevision": db["revision"], **data}
    mutate(client, "PATCH", f"/api/v1/databases/{a.db}/rows/{a.row}", body,
           ("row-set", a.db, a.row, data), a.request_id, a.force)


def cmd_db_prop(client, a):
    db = db_state(client, a.db)
    data = read_json(a.data)
    if not isinstance(data, dict):
        die("--data 需要 JSON 属性对象。")
    body = {"baseRevision": db["revision"], "property": data}
    if a.property_id:
        path = f"/api/v1/databases/{a.db}/properties/{a.property_id}"
        mutate(client, "PATCH", path, body, ("db-prop", a.db, a.property_id, data), a.request_id, a.force)
    else:
        path = f"/api/v1/databases/{a.db}/properties"
        mutate(client, "POST", path, body, ("db-prop", a.db, data), a.request_id, a.force)


def cmd_db_view(client, a):
    db = db_state(client, a.db)
    data = read_json(a.data)
    if not isinstance(data, dict):
        die("--data 需要 JSON 视图对象。")
    body = {"baseRevision": db["revision"], "view": data}
    if a.view_id:
        path = f"/api/v1/databases/{a.db}/views/{a.view_id}"
        mutate(client, "PATCH", path, body, ("db-view", a.db, a.view_id, data), a.request_id, a.force)
    else:
        path = f"/api/v1/databases/{a.db}/views"
        mutate(client, "POST", path, body, ("db-view", a.db, data), a.request_id, a.force)


def anon_request(url, method, path, body=None):
    """不带凭据的 /api 调用——授权请求的客户端侧。"""
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(url + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as res:
            status, text = res.status, res.read().decode()
    except urllib.error.HTTPError as e:
        status, text = e.code, e.read().decode()
    except urllib.error.URLError as e:
        die(f"无法连接 {url}: {e.reason}")
    print(f"# {method} {path} -> {status}", file=sys.stderr)
    try:
        return status, json.loads(text) if text else None
    except json.JSONDecodeError:
        return status, text


def save_config(url=None, token=None):
    """把 HEINOTE_URL / HEINOTE_TOKEN 写入 ~/.config/heinote/env（600）。
    只更新给出的项；其余键读旧文件保留。"""
    cfg = {}
    if os.path.exists(ENV_FILE):
        for line in open(ENV_FILE, encoding="utf-8"):
            if "=" in line:
                key, value = line.rstrip("\n").split("=", 1)
                cfg[key.strip()] = value
    if url is not None:
        cfg["HEINOTE_URL"] = url.rstrip("/")
    if token is not None:
        cfg["HEINOTE_TOKEN"] = token
    os.makedirs(os.path.dirname(ENV_FILE), exist_ok=True)
    with open(ENV_FILE, "w", encoding="utf-8") as f:
        for key in sorted(cfg):
            f.write(f"{key}={cfg[key]}\n")
    try:
        os.chmod(ENV_FILE, 0o600)
    except OSError:
        pass


def cmd_auth_request(client, a):
    import subprocess
    import time
    url = client.url  # Client() 已读取配置；token 缺省不会阻断此命令
    status, created = anon_request(url, "POST", "/api/v1/auth/requests",
                                   {"name": a.name, "access": a.access})
    if status != 201 or not isinstance(created, dict):
        emit(status, created)
    request_id_ = created["id"]
    verify = created["verificationUrl"]
    print(f"# 授权页: {verify}", file=sys.stderr)
    if a.open:
        opener = "open" if sys.platform == "darwin" else "xdg-open" if sys.platform.startswith("linux") else "start"
        try:
            subprocess.Popen([opener, verify], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print("# 已在浏览器打开授权页，等待用户批准…", file=sys.stderr)
        except OSError as e:
            print(f"# 自动打开失败（请手动访问上面的链接）: {e}", file=sys.stderr)
    else:
        print("# 请把上面的链接发给已登录用户打开并批准。", file=sys.stderr)

    deadline = time.time() + a.timeout
    while time.time() < deadline:
        time.sleep(a.interval)
        status, polled = anon_request(url, "GET", f"/api/v1/auth/requests/{request_id_}")
        state = (polled or {}).get("status") if isinstance(polled, dict) else None
        if state == "pending":
            continue
        if state == "approved":
            token = polled.get("token")
            if not token:
                die("请求已批准但令牌未下发（token 只在首次轮询返回一次）。"
                    "若你之前已拿过，直接用它；否则请用户在设置里重建。")
            save_config(url=url, token=token)
            print(f"# 令牌已保存到 {ENV_FILE}", file=sys.stderr)
            emit(status, {"status": "approved", "savedTo": ENV_FILE})
        emit(status, polled)  # denied / expired / 其他

    die(f"超时未获处理（{a.timeout} 秒）。用户未及时打开链接，或请求已过期。", 1)


def cmd_config(client, a):
    if a.show:
        cfg = load_config()
        emit(200, {"HEINOTE_URL": cfg.get("HEINOTE_URL") or DEFAULT_URL,
                   "HEINOTE_TOKEN": "已设置" if cfg.get("HEINOTE_TOKEN") else "未设置",
                   "envFile": ENV_FILE})
        return
    if not (a.url or a.token):
        die("config 需要 --url / --token，或 --show 查看当前生效值。")
    save_config(url=a.url, token=a.token)
    print(f"# 已写入 {ENV_FILE}", file=sys.stderr)
    emit(200, {"saved": [k for k, v in (("HEINOTE_URL", a.url), ("HEINOTE_TOKEN", a.token)) if v]})


def cmd_upload(client, a):
    import mimetypes
    import urllib.parse
    path = os.path.expanduser(a.file)
    if not os.path.isfile(path):
        die(f"文件不存在: {path}")
    with open(path, "rb") as f:
        data = f.read()
    query = {}
    if a.path:
        query["path"] = a.path
    if a.name:
        query["name"] = a.name
    media = (a.type or mimetypes.guess_type(path)[0] or "application/octet-stream").lower()
    url = f"{client.url}/api/v1/files/{a.scope}"
    if query:
        url += "?" + urllib.parse.urlencode(query)
    req = urllib.request.Request(url, data=data, method="PUT",
                                 headers={"Authorization": f"Bearer {client.token}",
                                          "Content-Type": media})
    try:
        with urllib.request.urlopen(req, timeout=120) as res:
            status, text = res.status, res.read().decode()
    except urllib.error.HTTPError as e:
        status, text = e.code, e.read().decode()
    except urllib.error.URLError as e:
        die(f"无法连接 {client.url}: {e.reason}")
    print(f"# PUT /api/v1/files/{a.scope} -> {status}", file=sys.stderr)
    try:
        emit(status, json.loads(text) if text else None)
    except json.JSONDecodeError:
        emit(status, text)


def cmd_download(client, a):
    import urllib.parse
    url = f"{client.url}/api/v1/files/{a.scope}?path={urllib.parse.quote(a.path, safe='')}"
    req = urllib.request.Request(url, method="GET",
                                 headers={"Authorization": f"Bearer {client.token}"})
    try:
        with urllib.request.urlopen(req, timeout=120) as res:
            data = res.read()
            status = res.status
    except urllib.error.HTTPError as e:
        status, data = e.code, e.read()
    except urllib.error.URLError as e:
        die(f"无法连接 {client.url}: {e.reason}")
    print(f"# GET /api/v1/files/{a.scope} -> {status}", file=sys.stderr)
    if status != 200:
        try:
            emit(status, json.loads(data.decode()))
        except (json.JSONDecodeError, UnicodeDecodeError):
            emit(status, None)
        return
    if a.out:
        target = os.path.expanduser(a.out)
        with open(target, "wb") as f:
            f.write(data)
        emit(200, {"saved": target, "bytes": len(data)})
    else:
        sys.stdout.buffer.write(data)


