    sp.add_argument("--data", help="JSON 对象、文件路径或 `-`")
    sp.add_argument("--request-id",
                    help="`auto` 按业务参数生成确定性标识；其他值原样使用。缺省不注入。")
    sp.set_defaults(fn=cmd_req)
    return p


def main():
    args = build_parser().parse_args()
    args.fn(Client(require_token=args.cmd not in ("auth-request", "config")), args)


if __name__ == "__main__":
    main()
