    sp.add_argument("--open", action="store_true", default=True, help="自动在浏览器打开授权页（默认）")
    sp.add_argument("--no-open", dest="open", action="store_false", help="不自动打开，只打印链接")
    sp.set_defaults(fn=cmd_auth_request)

    sp = sub.add_parser("upload", help="上传附件字节，返回可引用的 StoredFile JSON")
