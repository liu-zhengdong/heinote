    sp.set_defaults(fn=cmd_imports)

    sp = sub.add_parser("import-status", help="查询单个导入会话/任务状态与分片进度")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_import_status)

    sp = sub.add_parser("import-cancel", help="取消正在上传、排队或解析中的导入任务")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_import_cancel)

    sp = sub.add_parser("req", help="透传任意 /api/v1 请求")
    sp.add_argument("method")
    sp.add_argument("path", help="如 pages 或 /api/v1/pages/x/operations")
    sp.add_argument("--data", help="JSON 对象、文件路径或 `-`")
    sp.add_argument("--request-id",
                    help="`auto` 按业务参数生成确定性标识；其他值原样使用。缺省不注入。")
    sp.set_defaults(fn=cmd_req)
    return p


def main():
    args = build_parser().parse_args()
    args.fn(Client(require_token=args.cmd not in ("auth-request", "config")), args)


if __name__ == "__main__":
    main()
