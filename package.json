{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "name": "heinote",
  "version": "0.1.5",
  "repository": "https://github.com/liu-zhengdong/heinote",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts --dev",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:e2e": "playwright test",
    "test:container": "node tests/container-smoke.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run src && npm run test:server",
    "test:server": "tsx --test tests/server.test.ts tests/collaboration.test.ts tests/files.test.ts tests/export.test.ts tests/github-auth.test.ts tests/account-profile.test.ts tests/agent-databases.test.ts tests/account-avatar.test.ts tests/knowledge-bases.test.ts tests/import.test.ts tests/import-base.test.ts tests/admin-quotas.test.ts tests/agent-tokens.test.ts tests/migrations.test.ts tests/update.test.ts tests/webdav-backup.test.ts",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "diff": "^9.0.0",
    "express": "^5.1.0",
    "highlight.js": "11.12.0",
    "lib0": "^0.2.119",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "ws": "^8.22.1",
    "yjs": "^13.6.33",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.0.5",
    "emojibase-data": "^18.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
